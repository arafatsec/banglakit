{
  "name": "@arafatsec/banglakit",
  "version": "0.7.0",
  "description": "Bangla (Bengali) and Bangladesh tools for AI agents: taka in words, Bangla calendar, districts and upazilas, public holidays, phone numbers, phonetic typing. MCP server, CLI and library.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "banglakit": "bin/banglakit.js"
  },
  "files": [
    "src",
    "bin",
    "data/*.json",
    "data/README.md",
    "data/SOURCES.md",
    "data/licenses",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "coverage": "node --test --experimental-test-coverage",
    "datasets": "node datasets/generate.mjs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "bangla",
    "bengali",
    "mcp",
    "ai-agents",
    "claude",
    "transliteration",
    "bangla-calendar",
    "taka",
    "avro",
    "bangladesh",
    "districts",
    "upazila",
    "holidays",
    "phone-number",
    "nid",
    "hijri",
    "romanization"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafatsec/banglakit.git"
  },
  "bugs": {
    "url": "https://github.com/arafatsec/banglakit/issues"
  },
  "homepage": "https://github.com/arafatsec/banglakit#readme",
  "types": "src/index.d.ts",
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
